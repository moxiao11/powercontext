# LabTrace backend environment template.
# Copy to .env and fill in. Never commit real credentials.

# --- seekdb ---------------------------------------------------------------
# embedded : run seekdb in-process via pylibseekdb (Linux/macOS only)
# remote   : connect to a standalone OceanBase/seekdb server over MySQL protocol
SEEKDB_MODE=embedded
SEEKDB_PATH=/absolute/path/to/labtrace-seekdb-data

# remote mode only
# SEEKDB_HOST=127.0.0.1
# SEEKDB_PORT=2881
# SEEKDB_USER=root@test
# SEEKDB_PASSWORD=
# SEEKDB_DATABASE=labtrace

# Vector dimension. Must match the embedding model you configure.
EMBEDDING_DIMENSION=384

# FULLTEXT parser used by `CREATE FULLTEXT INDEX ... WITH PARSER <value>`.
# Verified on seekdb 1.4.0: `space` and `beng` cannot tokenize Chinese at all, so keyword and
# hybrid search over Chinese notes return zero rows. `ik` (default) segments Chinese words and
# stays precise on English terms; `ngram` also matches Chinese but over-matches English phrases.
# Changing this value rebuilds both fulltext indexes on the next backend start.
SEEKDB_FULLTEXT_PARSER=ik

# Maximum characters per document chunk. Chunks keep their source page number, and short
# trailing fragments are merged into the previous chunk instead of being dropped.
DOCUMENT_CHUNK_MAX_CHARS=700

# --- Optional OpenAI-compatible model APIs -------------------------------
# Without these, document import, seekdb retrieval, experiment records and
# PowerContext memory still work; generative answers are disabled.
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-...
# CHAT_MODEL=gpt-4o-mini
# EMBEDDING_MODEL=text-embedding-3-small

# --- PowerContext Server -------------------------------------------------
POWERCONTEXT_URL=http://127.0.0.1:8000
# POWERCONTEXT_TOKEN=

# --- LabTrace server -----------------------------------------------------
LABTRACE_HOST=0.0.0.0
LABTRACE_PORT=8100
# Comma separated list of allowed browser origins
LABTRACE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Upload limits
LABTRACE_MAX_UPLOAD_MB=20

# --- Docker Compose only (ignored by the native scripts) ------------------
# docker-compose.yml reads this file for variable substitution.
#
# REQUIRED for `docker compose up`: PowerContext refuses to bind a non-loopback address (which a
# container must do) while authentication is disabled, so the stack always runs with a static
# Bearer token. Generate one and keep it out of Git:  openssl rand -hex 18
# POWERCONTEXT_AUTH_TOKEN=
#
# Host ports. The defaults match the native dev scripts; change them if a native stack is running.
# LABTRACE_WEB_PORT=5173
# LABTRACE_API_PORT=8100
# POWERCONTEXT_PORT=8010
#
# Package/registry mirrors, useful when pypi.org, registry.npmjs.org or docker.io are unreachable:
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# NPM_REGISTRY=https://registry.npmmirror.com
# PYTHON_BASE_IMAGE=docker.1ms.run/library/python:3.12-slim
# NODE_BASE_IMAGE=docker.1ms.run/library/node:22-alpine
# NGINX_BASE_IMAGE=docker.1ms.run/library/nginx:1.27-alpine
#
# Only for docker/docker-compose.seekdb-server.yml (standalone OceanBase seekdb server + remote mode):
# SEEKDB_ROOT_PASSWORD=
# SEEKDB_MEMORY_LIMIT=4G
# SEEKDB_DATAFILE_SIZE=2G
# SEEKDB_LOG_DISK_SIZE=4G
