# LabTrace frontend: production Vite build served by nginx, which also proxies /api
# to the backend container so the browser only ever talks to one origin.
#
# Build context is the qoder/ directory:
#   docker build -f docker/Dockerfile.frontend -t labtrace-frontend .
#
# NODE_BASE_IMAGE / NGINX_BASE_IMAGE can point at a registry mirror when docker.io is
# unreachable, e.g. docker.m.daocloud.io/library/node:22-alpine.
ARG NODE_BASE_IMAGE=node:22-alpine
ARG NGINX_BASE_IMAGE=nginx:1.27-alpine

FROM ${NODE_BASE_IMAGE} AS build

ARG NPM_REGISTRY=https://registry.npmjs.org
ENV NPM_CONFIG_REGISTRY=${NPM_REGISTRY}

WORKDIR /app

COPY frontend/package.json frontend/package-lock.json* ./
RUN npm ci --no-audit --no-fund

COPY frontend/ ./
RUN npm run build

FROM ${NGINX_BASE_IMAGE}

COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=15s --timeout=4s --start-period=10s --retries=5 \
    CMD wget -q -O /dev/null http://127.0.0.1/ || exit 1
