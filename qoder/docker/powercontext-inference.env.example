# Optional PowerContext model-provider configuration for docker compose.
#
# Copy to docker/powercontext-inference.env (gitignored) and fill in. docker-compose.yml loads
# that file with `required: false`, so leaving it absent is the supported default.
#
# IMPORTANT: these variables must be *unset*, not empty. PowerContext's ServerSettings rejects
# empty inference identifiers with "inference identifiers must not be empty", so an empty value
# in docker-compose.yml stops the container. Comment out anything you do not use.
#
# What each setting unlocks (verified against PowerContext 1.2.0):
#   * Without a generation model: explicit Memory writes, revise/retire, Source capture and
#     Handoff all work -- LabTrace's core memory features do not need a model.
#     /v1/memory/flush returns 422 capability_not_supported (extract), /v1/topic-memory/flush
#     returns 503, and /v1/context/prepare returns status=empty. The LabTrace UI says so.
#   * With a generation model + POWERCONTEXT_SERVER_RUNTIME_SCHEDULE_SECONDS: automatic memory
#     extraction from captured Sources, Topic Memory and non-empty PreparedContext.
#
# Model identifiers use Pydantic AI's `provider:model-name` form; provider credentials are read
# from the provider's own environment variable (OPENAI_API_KEY for OpenAI-compatible providers).

# POWERCONTEXT_SERVER_INFERENCE_GENERATION_MODEL=openai:gpt-4o-mini
# POWERCONTEXT_SERVER_INFERENCE_GENERATION_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-...

# Seconds between automatic extraction runs. Required for scheduled extraction; explicit Memory
# writes do not use it.
# POWERCONTEXT_SERVER_RUNTIME_SCHEDULE_SECONDS=30

# Extraction profile: `coding` (default) keeps working context such as decisions, constraints and
# unfinished progress; `conversation` keeps independently answerable people/date/list facts.
# POWERCONTEXT_SERVER_RUNTIME_MEMORY_EXTRACTION_PROFILE=coding

# Embeddings are only needed for Topic Memory / semantic recall inside PowerContext. LabTrace's
# own paper and experiment vectors are produced by the backend and stored in seekdb directly.
# POWERCONTEXT_SERVER_INFERENCE_EMBEDDING_MODEL=openai:text-embedding-3-small
# POWERCONTEXT_SERVER_INFERENCE_EMBEDDING_PROFILE_ID=text-embedding-3-small
# POWERCONTEXT_SERVER_INFERENCE_EMBEDDING_DIMENSION=1536
