# PowerContext Server environment for LabTrace (embedded seekdb backend).
# Copy to powercontext.env and adjust paths. Never commit real credentials.

POWERCONTEXT_SERVER_HTTP_HOST=127.0.0.1
POWERCONTEXT_SERVER_HTTP_PORT=8000

# Embedded seekdb storage (Linux/macOS). __LABTRACE_HOME__ is replaced by
# scripts/start-powercontext.sh with the real home directory.
POWERCONTEXT_SERVER_DATABASE_KIND=seekdb
POWERCONTEXT_SERVER_DATABASE_PATH=__LABTRACE_HOME__/labtrace-data/powercontext-seekdb

POWERCONTEXT_SERVER_ACCESS_MODE=disabled
POWERCONTEXT_SERVER_MCP_ENABLED=true
POWERCONTEXT_SERVER_LOGGING_LEVEL=INFO

# Explicit Memory writes need no model API. Configure these only if you want
# automatic memory extraction / handoff generation.
# POWERCONTEXT_SERVER_INFERENCE_GENERATION_MODEL=
# POWERCONTEXT_SERVER_INFERENCE_GENERATION_API_KEY=
