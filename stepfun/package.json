{
  "name": "stepfun-tide-knowledge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.5.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch server/index.ts\" \"vite --host 127.0.0.1 --port 5178\"",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "models:download": "node scripts/download-models.mjs",
    "runtime:copy": "node scripts/copy-runtime.mjs",
    "postinstall": "npm run runtime:copy",
    "test": "vitest run",
    "test:integration": "tsx tests/integration.ts",
    "test:restart": "tsx tests/restart.ts",
    "db:up": "docker compose up -d --wait seekdb",
    "db:down": "docker compose stop seekdb",
    "report": "node scripts/report.mjs",
    "test:browsers": "node tests/browser-compatibility.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "3.8.1",
    "dotenv": "17.2.3",
    "express": "5.1.0",
    "lucide-react": "0.468.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "seekdb": "1.4.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/express": "5.0.5",
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.0.4",
    "concurrently": "9.2.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.1.12",
    "vitest": "3.2.4"
  }
}
