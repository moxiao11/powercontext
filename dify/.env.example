# PowerContext Server 配置
# 默认本地 Server 不启用鉴权；启用后填入 token（来自 secret store，不要提交真实值）
POWERCONTEXT_URL=http://127.0.0.1:8000
POWERCONTEXT_TOKEN=

# 游戏状态数据库（SQLite）
DATABASE_URL=sqlite:///./grudgetown.db

# 游戏规则参数
GAME_DEFAULT_COINS=100
GAME_MAX_TURNS=10
GAME_RANDOM_SEED=42
GAME_TURNS_PER_DAY=2

# 值得写入 PowerContext 长期记忆的事件最低重要度
GAME_MEMORY_IMPORTANCE_THRESHOLD=5

# FastAPI 服务配置
API_HOST=127.0.0.1
API_PORT=8001

# PowerContext 请求超时（秒）与连接错误重试次数
POWERCONTEXT_TIMEOUT=10
POWERCONTEXT_MAX_RETRIES=2
